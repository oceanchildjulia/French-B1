<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>MÉTHODE — Französisch bis B1</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
  :root{
    --bg:#ffffff; --bg-soft:#f5f3f0; --bg-panel:#efece7;
    --ink:#121212; --ink-2:#6f6b66; --line:#e4e1dc; --sand:#d8d2c6;
  }
  *{margin:0;padding:0;box-sizing:border-box}
  html{scroll-behavior:smooth}
  [id]{scroll-margin-top:84px}
  body{font-family:'Inter',system-ui,sans-serif;background:var(--bg);color:var(--ink);font-size:14px;line-height:1.6;-webkit-font-smoothing:antialiased}
  ::selection{background:var(--ink);color:#fff}
  a{color:inherit;text-decoration:none}
  button{font:inherit;color:inherit;background:none;border:none;cursor:pointer}
  ul{list-style:none}
  :focus-visible{outline:1px solid var(--ink);outline-offset:3px}
  .container{max-width:1280px;margin-inline:auto;padding-inline:clamp(1.25rem,4vw,3rem)}
  .mono{font-family:'IBM Plex Mono',monospace}
  .eyebrow{display:flex;align-items:center;gap:.8rem;font-family:'IBM Plex Mono',monospace;font-size:10px;letter-spacing:.25em;text-transform:uppercase;color:var(--ink-2)}
  .eyebrow::before{content:"";width:2rem;height:1px;background:var(--ink)}
  .btn{display:inline-flex;align-items:center;justify-content:center;gap:.6rem;padding:1rem 1.8rem;font-size:11px;letter-spacing:.14em;text-transform:uppercase;font-weight:500;border:1px solid var(--ink);background:transparent;color:var(--ink);transition:background .25s,color .25s}
  .btn:hover{background:var(--ink);color:#fff}
  .btn--solid{background:var(--ink);color:#fff}
  .btn--solid:hover{background:#000;border-color:#000}
  .btn--sm{padding:.6rem 1rem;font-size:10px}

  /* Header */
  .site-header{position:sticky;top:0;z-index:50;background:rgba(255,255,255,.88);backdrop-filter:blur(10px);border-bottom:1px solid transparent;transition:border-color .3s}
  .site-header.is-scrolled{border-bottom-color:var(--line)}
  .header__inner{display:flex;align-items:center;gap:2rem;height:64px}
  .logo{font-size:16px;font-weight:600;letter-spacing:.28em;text-transform:uppercase}
  .logo span{color:var(--ink-2)}
  .main-nav{display:flex;gap:1.8rem;margin-left:1rem}
  .main-nav a{font-size:12px;letter-spacing:.12em;text-transform:uppercase;font-weight:500;text-underline-offset:6px}
  .main-nav a:hover{text-decoration:underline}
  .main-nav a.is-active{text-decoration:underline}
  .header-spacer{flex:1}
  .nav-toggle{display:none;flex-direction:column;gap:5px;padding:6px 0}
  .nav-toggle span{width:20px;height:1.5px;background:var(--ink)}

  /* Hero / Dashboard */
  .hero{display:grid;grid-template-columns:1.1fr .9fr;gap:clamp(2rem,5vw,4rem);align-items:center;padding-block:clamp(2.5rem,6vw,5rem)}
  .hero__title{font-size:clamp(2.1rem,5vw,3.6rem);font-weight:500;line-height:1.04;text-transform:uppercase;letter-spacing:.01em;margin:1.4rem 0 1.2rem}
  .hero__title span{color:var(--ink-2)}
  .hero__lead{color:var(--ink-2);font-size:15px;max-width:44ch;margin-bottom:2rem}
  .dash{background:var(--bg-panel);padding:clamp(1.5rem,3vw,2.5rem);display:grid;gap:1.4rem}
  .dash__progress{display:flex;justify-content:space-between;align-items:baseline;font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:var(--ink-2);margin-bottom:.7rem}
  .dash__progress strong{font-size:1.5rem;letter-spacing:0;color:var(--ink)}
  .bar{height:6px;background:var(--bg);position:relative;overflow:hidden}
  .bar__fill{position:absolute;inset:0;right:auto;background:var(--ink);width:0;transition:width .6s cubic-bezier(.2,.7,.2,1)}
  .bar--slim{height:4px}
  .dash__grid{display:grid;grid-template-columns:1fr 1fr;gap:1.3rem;border-top:1px solid var(--line);padding-top:1.3rem}
  .stat strong{font-size:clamp(1.4rem,2.4vw,2rem);font-weight:500;display:block}
  .stat em{font-style:normal;font-family:'IBM Plex Mono',monospace;font-size:10px;letter-spacing:.16em;text-transform:uppercase;color:var(--ink-2)}
  .dash__row{display:grid;grid-template-columns:auto 1fr auto;gap:1rem;align-items:center;border-top:1px solid var(--line);padding-top:1.3rem}
  .dash__row-label{font-family:'IBM Plex Mono',monospace;font-size:10px;letter-spacing:.16em;text-transform:uppercase;color:var(--ink-2)}

  section.block{padding-block:clamp(3rem,7vw,5.5rem)}
  section.block--soft{background:var(--bg-soft)}
  .sec-head{display:flex;align-items:flex-end;justify-content:space-between;gap:1.5rem;margin-bottom:2.4rem;flex-wrap:wrap}
  .sec-head .kicker{display:block;font-family:'IBM Plex Mono',monospace;font-size:10px;letter-spacing:.25em;text-transform:uppercase;color:var(--ink-2);margin-bottom:.7rem}
  .sec-head h2{font-size:clamp(1.5rem,3vw,2.3rem);font-weight:500;text-transform:uppercase;letter-spacing:.02em;line-height:1.1}
  .sec-link{font-size:12px;letter-spacing:.12em;text-transform:uppercase;font-weight:500;white-space:nowrap;text-underline-offset:6px}
  .sec-link:hover{text-decoration:underline}

  /* Phonetik */
  .phon-grid{display:grid;grid-template-columns:.85fr 1.15fr;gap:clamp(1.5rem,4vw,3rem)}
  .phon-list{border-top:1px solid var(--ink)}
  .phon-list button{display:flex;justify-content:space-between;gap:1rem;width:100%;text-align:left;padding:.9rem 0;border-bottom:1px solid var(--line);font-size:13px;font-weight:500;letter-spacing:.03em;transition:padding .2s}
  .phon-list button:hover{padding-left:.4rem}
  .phon-list button .arrow{color:var(--ink-2)}
  .phon-list button.is-active{font-weight:600}
  .phon-detail{background:var(--bg-panel);padding:clamp(1.4rem,3vw,2.2rem);min-height:100%;display:flex;flex-direction:column;gap:1rem}
  .phon-detail h3{font-size:1.6rem;font-weight:500;letter-spacing:.02em}
  .phon-detail .hint{font-size:13px;color:var(--ink-2)}
  .exs{display:flex;flex-wrap:wrap;gap:.6rem}
  .exs button{border:1px solid var(--line);background:var(--bg);padding:.5rem .9rem;font-size:13px}
  .exs button:hover{border-color:var(--ink)}
  .pron{font-family:'IBM Plex Mono',monospace;font-size:13px;letter-spacing:.05em;color:var(--ink-2)}

  /* Vokabeln */
  .deck-tools{display:flex;flex-wrap:wrap;gap:1rem;align-items:center;border:1px solid var(--line);padding:1rem 1.2rem;margin-bottom:1.5rem}
  .deck-tools .count{font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:.12em;color:var(--ink-2);margin-left:auto}
  .deck-tools select,.deck-tools input[type=search]{font:inherit;font-size:12px;padding:.5rem .7rem;border:1px solid var(--line);background:#fff;color:var(--ink)}
  .flashcard{max-width:520px;margin:0 auto}
  .flashcard__inner{position:relative;display:grid;place-items:center;min-height:300px;padding:2rem;text-align:center;transform-style:preserve-3d;transition:transform .55s cubic-bezier(.2,.7,.2,1)}
  .flashcard.is-flipped .flashcard__inner{transform:rotateY(180deg)}
  .flashcard__face{position:absolute;inset:0;padding:2rem;background:var(--bg);border:1px solid var(--line);display:flex;flex-direction:column;justify-content:center;align-items:center;gap:.8rem;backface-visibility:hidden}
  .flashcard__face--back{background:var(--bg-soft);transform:rotateY(180deg)}
  .flashcard__big{font-size:clamp(1.6rem,4vw,2.6rem);font-weight:500;letter-spacing:.01em}
  .flashcard__sub{font-size:13px;color:var(--ink-2)}
  .flashcard__cat{font-family:'IBM Plex Mono',monospace;font-size:10px;letter-spacing:.18em;text-transform:uppercase;color:var(--ink-2);border:1px solid var(--line);padding:2px 8px}
  .flashcard__say{margin-top:.4rem}
  .flashcard__ctrl{display:flex;justify-content:center;gap:1rem;margin-top:1.4rem}
  .flashcard__ctrl .btn{opacity:1}
  @media (hover:none){.flashcard__ctrl{display:none}}
  .fc-nav{display:flex;justify-content:space-between;align-items:center;max-width:520px;margin:1rem auto 0;font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:.12em;color:var(--ink-2)}
  .fc-nav button{font:inherit}
  .vocab-list{border-top:1px solid var(--ink);margin-top:2.5rem}
  .vocab-list .row{display:grid;grid-template-columns:auto 1fr auto auto;gap:1rem;align-items:center;padding:.8rem 0;border-bottom:1px solid var(--line);font-size:13px}
  .vocab-list .row .idx{font-family:'IBM Plex Mono',monospace;font-size:11px;color:var(--ink-2)}
  .vocab-list .row .cat{font-family:'IBM Plex Mono',monospace;font-size:10px;letter-spacing:.14em;text-transform:uppercase;color:var(--ink-2)}
  .vocab-list .row button{font-size:10px;letter-spacing:.12em;text-transform:uppercase;border:1px solid var(--line);padding:.4rem .6rem}
  .vocab-list .row button:hover{border-color:var(--ink)}
  .form{display:flex;gap:.8rem;flex-wrap:wrap;border-top:1px solid var(--line);padding-top:1.2rem}
  .form input,.form select{font:inherit;font-size:12px;padding:.6rem .7rem;border:1px solid var(--line);background:#fff}
  .form input{flex:1;min-width:140px}

  /* Grammatik */
  .gram-grid{display:grid;grid-template-columns:.85fr 1.15fr;gap:clamp(1.5rem,4vw,3rem)}
  .gram-detail{background:var(--bg-panel);padding:clamp(1.4rem,3vw,2.2rem);display:flex;flex-direction:column;gap:1rem}
  .gram-detail p{font-size:14px;color:var(--ink-2)}
  .gram-detail h4{font-family:'IBM Plex Mono',monospace;font-size:10px;letter-spacing:.2em;text-transform:uppercase;color:var(--ink-2);margin-bottom:.4rem}
  .examples{display:flex;flex-direction:column;gap:.5rem}
  .examples div{display:grid;grid-template-columns:1fr auto;gap:1rem;padding:.7rem .9rem;background:var(--bg);border:1px solid var(--line);font-size:13px}
  .examples button{align-self:center}

  /* Material */
  .mat-grid{display:grid;grid-template-columns:1fr 1fr;gap:2rem}
  .mat-list{border-top:1px solid var(--ink)}
  .mat-item{display:flex;align-items:center;gap:.9rem;padding:.9rem 0;border-bottom:1px solid var(--line)}
  .mat-item a{flex:1;font-size:13px;font-weight:500;display:flex;justify-content:space-between;gap:1rem}
  .mat-item a:hover{opacity:.6}
  .chip{font-family:'IBM Plex Mono',monospace;font-size:9px;letter-spacing:.14em;text-transform:uppercase;border:1px solid var(--line);padding:2px 7px;color:var(--ink-2);white-space:nowrap}

  /* Fortschritt */
  .prog-head{display:flex;justify-content:space-between;align-items:center;gap:1rem;flex-wrap:wrap;margin-bottom:1.5rem}
  .prog-ctrls{display:flex;gap:.7rem;flex-wrap:wrap}
  .log{border-top:1px solid var(--ink)}
  .log .row{display:grid;grid-template-columns:1fr 1fr 1fr auto;gap:1rem;padding:.8rem 0;border-bottom:1px solid var(--line);font-size:13px;align-items:center}
  .log .row .t{font-family:'IBM Plex Mono',monospace;font-size:11px;color:var(--ink-2)}
  .log .row button{font-size:10px;color:var(--ink-2);border:1px solid var(--line);padding:.35rem .55rem}
  .log .row button:hover{color:var(--ink);border-color:var(--ink)}
  .log--empty{padding:2rem 0;text-align:center;color:var(--ink-2);border:0}

  /* Footer */
  footer{border-top:1px solid var(--line);padding:2.5rem 0 1.8rem}
  .footer__legal{display:flex;justify-content:space-between;flex-wrap:wrap;gap:.8rem;font-family:'IBM Plex Mono',monospace;font-size:10px;letter-spacing:.12em;color:var(--ink-2);text-transform:uppercase}
  .footer__legal a:hover{color:var(--ink)}

  /* Mobile-Menü */
  .mmenu{position:fixed;inset:0;z-index:80;background:#fff;display:flex;flex-direction:column;padding:1.2rem clamp(1.25rem,4vw,3rem) 2.5rem;transform:translateY(-100%);transition:transform .45s cubic-bezier(.2,.7,.2,1)}
  .mmenu.is-open{transform:none}
  .mmenu__top{display:flex;justify-content:space-between;align-items:center;height:40px}
  .mmenu__close{font-size:11px;letter-spacing:.16em;text-transform:uppercase}
  .mmenu nav{margin-top:12vh;display:flex;flex-direction:column}
  .mmenu nav a{font-size:clamp(1.6rem,7vw,2.4rem);font-weight:500;text-transform:uppercase;padding:.55rem 0;border-bottom:1px solid var(--line)}
  .mmenu__foot{margin-top:auto;font-family:'IBM Plex Mono',monospace;font-size:10px;letter-spacing:.2em;text-transform:uppercase;color:var(--ink-2)}

  /* Toast */
  .toast{position:fixed;left:50%;bottom:1.5rem;z-index:120;transform:translate(-50%,14px);opacity:0;pointer-events:none;background:var(--ink);color:#fff;padding:.85rem 1.4rem;font-size:11px;letter-spacing:.12em;text-transform:uppercase;max-width:calc(100vw - 2rem);text-align:center;transition:opacity .3s,transform .3s}
  .toast.show{opacity:1;transform:translate(-50%,0)}

  /* Reveal */
  .reveal{opacity:0;transform:translateY(18px);transition:opacity .7s ease,transform .7s ease}
  .reveal.is-in{opacity:1;transform:none}

  @media (max-width:900px){
    .main-nav{display:none}.nav-toggle{display:flex}
    .hero,.phon-grid,.gram-grid,.mat-grid{grid-template-columns:1fr}
    .dash__grid{grid-template-columns:1fr 1fr}
  }
  @media (max-width:560px){
    .dash__grid,.flashcard__ctrl{gap:.8rem}
    .log .row{grid-template-columns:1fr 1fr;row-gap:.3rem}
    .log .row .act{grid-column:2}
    .vocab-list .row{grid-template-columns:auto 1fr auto}
    .vocab-list .row .cat{display:none}
  }
  @media (prefers-reduced-motion:reduce){
    html{scroll-behavior:auto}
    .reveal{opacity:1;transform:none;transition:none}
    .flashcard__inner,.bar__fill,.mmenu{transition:none}
  }
</style>
</head>
<body id="top">

  <header class="site-header" id="site-header">
    <div class="container header__inner">
      <button class="nav-toggle" id="nav-toggle" aria-label="Menü öffnen"><span></span><span></span></button>
      <a class="logo" href="#top">MÉTHODE<span>.</span></a>
      <nav class="main-nav">
        <a href="#phonetik">Phonetik</a>
        <a href="#vokabeln">Vokabeln</a>
        <a href="#grammatik">Grammatik</a>
        <a href="#material">Material</a>
        <a href="#fortschritt">Fortschritt</a>
      </nav>
      <div class="header-spacer"></div>
    </div>
  </header>

  <div class="mmenu" id="mmenu" aria-hidden="true">
    <div class="mmenu__top"><span class="logo">MÉTHODE<span>.</span></span><button class="mmenu__close" id="mmenu-close">Schließen ×</button></div>
    <nav>
      <a href="#phonetik">Phonetik</a>
      <a href="#vokabeln">Vokabeln</a>
      <a href="#grammatik">Grammatik</a>
      <a href="#material">Material</a>
      <a href="#fortschritt">Fortschritt</a>
    </nav>
    <p class="mmenu__foot">Ziel: B1 — 1. August 2027</p>
  </div>

  <main>
    <!-- ===== Dashboard ===== -->
    <section class="container hero" id="dashboard">
      <div class="reveal">
        <p class="eyebrow">Dein Französisch-Plan · Start <span id="hud-start" class="mono"></span></p>
        <h1 class="hero__title">Französisch,<br><span>geplant auf B1.</span></h1>
        <p class="hero__lead">Fünfzig Stunden Aussprache, eintausend Wörter, dann Grammatik bis zum Ziel. <strong id="hud-daily">65</strong> Minuten pro Tag. <strong id="hud-days">0</strong> Tage bis zum 1. August 2027.</p>
        <a class="btn btn--solid" href="#phonetik">Weitermachen →</a>
      </div>
      <div class="dash reveal">
        <div>
          <div class="dash__progress"><span>Gesamtfortschritt</span><strong id="dash-pct">0%</strong></div>
          <div class="bar"><div class="bar__fill" id="dash-fill"></div></div>
        </div>
        <div class="dash__grid">
          <div class="stat"><strong><span id="dash-studied">0</span> / <span id="dash-vocab-total">0</span></strong><em>Wörter gelernt</em></div>
          <div class="stat"><strong id="dash-hours">0,0 h</strong><em>Studienzeit</em></div>
        </div>
        <div class="dash__row">
          <span class="dash__row-label">Tagesziel</span>
          <div class="bar bar--slim"><div class="bar__fill" id="day-fill"></div></div>
          <span class="mono" id="day-mins">0 / 65 Min.</span>
        </div>
      </div>
    </section>

    <!-- ===== Phonetik ===== -->
    <section id="phonetik" class="container">
      <div class="sec-head reveal">
        <div><span class="kicker">Phase 01 — 50 h</span><h2>Aussprache &amp; Phonetik</h2></div>
        <span class="sec-link mono" id="phon-progress"></span>
      </div>
      <div class="phon-grid reveal">
        <div class="phon-list" id="phon-list"></div>
        <div class="phon-detail" id="phon-detail"></div>
      </div>
    </section>

    <!-- ===== Vokabeln ===== -->
    <section id="vokabeln" class="block block--soft">
      <div class="container">
        <div class="sec-head reveal">
          <div><span class="kicker">Phase 02 — 350 h</span><h2>Die 1.000 wichtigsten Wörter</h2></div>
          <span class="sec-link mono" id="vocab-progress"></span>
        </div>

        <div class="deck-tools reveal">
          <select id="deck-filter" aria-label="Kategorie filtern"></select>
          <input type="search" id="deck-search" placeholder="Suchen…" aria-label="Vokabeln durchsuchen">
          <label style="display:flex;align-items:center;gap:.5rem;font-size:11px;letter-spacing:.08em;text-transform:uppercase">
            <input type="checkbox" id="deck-learn"> Nur Lernende
          </label>
          <span class="count" id="deck-count"></span>
        </div>

        <div class="flashcard" id="flashcard">
          <div class="flashcard__inner" id="flashcard-inner">
            <div class="flashcard__face flashcard__face--front" style="transform:rotateY(0deg)">
              <span class="flashcard__cat" id="fc-cat"></span>
              <div class="flashcard__big" id="fc-front">—</div>
              <div class="flashcard__sub">Karte antippen zum Umdrehen</div>
              <button class="btn btn--sm flashcard__say" id="fc-say1">◊ Aussprechen</button>
            </div>
            <div class="flashcard__face flashcard__face--back">
              <div class="flashcard__big" id="fc-back">—</div>
              <div class="flashcard__sub pron" id="fc-pron"></div>
              <div class="flashcard__sub" id="fc-ex"></div>
              <button class="btn btn--sm flashcard__say" id="fc-say2">◊ Aussprechen</button>
            </div>
          </div>
        </div>
        <div class="flashcard__ctrl">
          <button class="btn" id="fc-shuffle">Shuffle</button>
          <button class="btn btn--solid" id="fc-flip">Umkehren</button>
        </div>
        <div class="fc-nav">
          <button id="fc-prev">← Vorige</button>
          <span id="fc-idx">0 / 0</span>
          <button id="fc-next">Nächste →</button>
        </div>

        <div class="vocab-list" id="vocab-list"></div>

        <div class="form reveal">
          <input type="text" id="v-fr" placeholder="Französisch">
          <input type="text" id="v-de" placeholder="Deutsch">
          <input type="text" id="v-pron" placeholder="Aussprache" class="mono">
          <input type="text" id="v-ex" placeholder="Beispielsatz">
          <select id="v-cat"></select>
          <button class="btn btn--solid" id="v-add">Hinzufügen</button>
        </div>
      </div>
    </section>

    <!-- ===== Grammatik ===== -->
    <section id="grammatik" class="container">
      <div class="sec-head reveal">
        <div><span class="kicker">Phase 03 — 350 h</span><h2>Grammatik · A2 → B1</h2></div>
        <span class="sec-link mono" id="gram-progress"></span>
      </div>
      <div class="gram-grid reveal">
        <div class="phon-list" id="gram-list"></div>
        <div class="gram-detail" id="gram-detail"></div>
      </div>
    </section>

    <!-- ===== Material ===== -->
    <section id="material" class="block block--soft">
      <div class="container">
        <div class="sec-head reveal">
          <div><span class="kicker">Ressourcen</span><h2>Leselisten &amp; Lernmaterial</h2></div>
        </div>
        <div class="mat-grid reveal">
          <div class="mat-list" id="mat-reading"></div>
          <div class="mat-list" id="mat-practice"></div>
        </div>
      </div>
    </section>

    <!-- ===== Fortschritt ===== -->
    <section id="fortschritt" class="container">
      <div class="prog-head reveal">
        <div><span class="kicker" style="display:block;font-family:'IBM Plex Mono',monospace;font-size:10px;letter-spacing:.25em;text-transform:uppercase;color:var(--ink-2);margin-bottom:.6rem">Dokumentation</span><h2 style="font-size:clamp(1.5rem,3vw,2.3rem);font-weight:500;text-transform:uppercase">Lernprotokoll</h2></div>
        <div class="prog-ctrls">
          <input type="date" id="log-date" aria-label="Datum">
          <input type="number" id="log-mins" min="0" step="5" placeholder="Minuten" style="width:9rem" aria-label="Minuten">
          <select id="log-note" aria-label="Notiz"></select>
          <button class="btn btn--solid btn--sm" id="log-add">Eintragen</button>
          <button class="btn btn--sm" id="log-export">CSV-Export</button>
        </div>
      </div>
      <div class="log" id="log"></div>
    </section>
  </main>

  <footer>
    <div class="container footer__legal">
      <span>© 2025 MÉTHODE — persönliches Lernprojekt</span>
      <span>Ziel: Französisch B1 · 1. August 2027 · ~65 Min./Tag</span>
    </div>
  </footer>

  <div class="toast" id="toast" role="status"></div>

<script>
/* ================== SPEICHERN ================== */
const KEY = 'methode-fr-1';
const store = {
  load(){ try{ return JSON.parse(localStorage.getItem(KEY)) || {}; }catch(e){ return {}; } },
  save(s){ localStorage.setItem(KEY, JSON.stringify(s)); }
};
let state = Object.assign(
  { vocabulary:[], extra:[], studied:{}, phon:{}, gram:{}, log:[], start:'' },
  store.load()
);
if(!state.start){ state.start = new Date().toISOString().slice(0,10); }
const save = () => store.save(state);
const today = () => new Date().toISOString().slice(0,10);

/* ================== KONSTANTEN & DATEN ================== */
const DAILY = 65;
const GOAL = new Date('2027-08-01T00:00:00');
const TOTAL_VOCAB = 1000;
const TOTAL_HOURS = 750;

const PHONETIC = [
  {id:'a', name:'A &amp; E — [a] [ɛ]', hint:'Das offene A (wie in „Basse") vs. das geschlossene [ɛ] (wie in „Café"). Deutsch-Sprecher trennen beide klar.', ex:['ma','la','papa','café','été','belle','mer']},
  {id:'u', name:'OU &amp; U — [u] [y]', hint:'Der berüchtigte [y] (geschlossenes U, Lippen wie bei „U" aber Zunge wie bei „I" — „tu", „vous").', ex:['tu','vous','dur','musique','lune','rouge','fleur']},
  {id:'nasal', name:'Nasale — [ɑ̃] [ɔ̃] [ɛ̃]', hint:'Drei Nasalvokale. Nasale Endungs-silben wie -on, -en, -in werden nasal, nicht „n"+Vokal gesprochen.', ex:['bon','mon','manger','brun','pain','vin','chanson']},
  {id:'r', name:'Das R — [ʁ]', hint:'Das harte, gurgelnde R aus dem Rachen — nicht das deutsche Wälz-R. Übe langsam, von hinten nach vorn.', ex:['rouge','Paris','cher','mère','brûler','travail']},
  {id:'s', name:'S — [s] [z] [ʃ] [ʒ]', hint:'Schwerpunkt: [s] vs. [z] (französisches „s" klingt wie „s", nie wie „z"!) und das weiche [ʒ] (wie „s" in „mesure").', ex:['sans','soleil','zéro','mesure','travailler','jardin','plage']},
  {id:'conson', name:'Stumme Konsonanten', hint:'Französisch liest nicht, was geschrieben steht. Stumme Endungs-lauter (t, d, s, x) nach dem Vokal verschwinden.', ex:['jour','femme','petit','château','grand','parfum']},
  {id:'liaison', name:'Liaison &amp; Enchaînement', hint:'Stumme Endungs-lauter werden vor einem Wort gesprochen, das mit einem Vokal beginnt (le ami → „leza-mi").', ex:['les amis','vous avez','un enfant','nous avons','trois autres']},
  {id:'accent', name:'Akzente &amp; Betonung', hint:'Jedes Wort ist im Französischen auf der letzten betonte Silbe betont — fließend, ohne deutsches Wort-Akzent.', ex:['bonjour','français','aujourd’hui','merveilleux','important']}
];

const GRAMMAR = [
  {id:'art', name:'Artikel', hint:'Bestimmte (le/la/les, l’), unbestimmte (un/une/des, d’) und der Teilungsartikel (du, de la, de l’).', ex:['Le soleil est chaud.','Une femme chante.','Je mange du pain.']},
  {id:'verbeetre', name:'Être &amp; Avoir', hint:'Die zwei Stützwörter — präsente Form. Sie tragen die Hälfte des Sprachalltags.', ex:['Je suis français.','Tu as faim.','Nous sommes contents.']},
  {id:'present', name:'Präsens der -er-Verben', hint:'Die produktivste Endungsgruppe (parler, manger, travailler). Regelmäßig und vorhersagbar.', ex:['Je parle.','Tu manges.','Ils travaillent.']},
  {id:'neg', name:'Negation', hint:'ne … pas / ne … jamais / ne … plus — die Verneinung klemmt das Verb ein.', ex:['Je ne suis pas fatigué.','Il ne mange pas.','Elle ne dort plus.']},
  {id:'imparfait', name:'L’imparfait', hint:'Das „frühere Dauerzustand" — Hintergrund, Gewohnheit, Beschreibung in der Vergangenheit.', ex:['Je jouais du piano.','Il pleuvait souvent.','Elle était très timide.']},
  {id:'passcompose', name:'Le passé composé', hint:'Beendete Handlung (auxiliaire être/havoir + Participe passé). Der Standard der Erzählung.', ex:['J’ai mangé une pomme.','Elle est partie.','Nous avons voyagé.']},
  {id:'futur', name:'Le futur proche', hint:'aller + Infinitiv — das einfache „ich werde …". Ideal, um über Pläne zu sprechen.', ex:['Je vais manger.','Nous allons voyager.','Ils vont partir.']},
  {id:'subjonctif', name:'Le subjonctif', hint:'B1-Kernthema: Subjunktiv nach Meinung, Emotion, Unsicherheit (il faut que, je pense que…).', ex:['Il faut que tu viennes.','Je doute qu’il soit là.','Bien qu’elle soit jeune…']},
  {id:'relatives', name:'Relativsätze', hint:'qui, que, dont, où — verbindet Sätze und hebt den Wortschatz auf B1-Niveau.', ex:['L’homme qui parle est mon frère.','Le livre que tu lis est bon.','La maison où je vis…']}
];

const READING = [
  {name:'Le Petit Prince (L’étranger)', tag:'A1–A2', url:'https://www.letranger.fr'},
  {name:'L’Etranger (Le Petit Prince, Audio)', tag:'A2', url:'https://www.letranger.fr/audiolibre'},
  {name:'L’Ecole des loisirs — Jeunesse', tag:'A2', url:'https://www.ecoledesloisirs.fr'},
  {name:'L’Etranger — Grands classiques', tag:'A2', url:'https://www.letranger.fr/classiques'},
  {name:'France Inter — Journal en français facile', tag:'A2–B1', url:'https://www.radiofrance.fr/france-inter'},
  {name:'Le Figaro — Édition abonnés', tag:'B1', url:'https://www.lefigaro.fr'},
  {name:'Le Point — Édition abonnés', tag:'B1', url:'https://www.lepoint.fr'},
  {name:'TV5Monde — Français facile', tag:'A2–B1', url:'https://apprendre.tv5monde.com/fr'}
];
const PRACTICE = [
  {name:'Duolingo — Français', tag:'Täglich', url:'https://www.duolingo.com'},
  {name:'BBC Learning French (A2)', tag:'Audio', url:'https://www.bbc.co.uk/learningenglish/french'},
  {name:'Learn French with Alexa (Podcast)', tag:'Podcast', url:'https://www.learnfrenchwithalexa.com'},
  {name:'Khan Academy — French (Klasse A2)', tag:'Übung', url:'https://fr.khanacademy.org'},
  {name:'France.tv — Cinéma & Docs', tag:'Video', url:'https://www.france.tv'},
  {name:'Anki — French 1000 Deck', tag:'Spaced Repetition', url:'https://ankiweb.net/shared/decks'}
];

const SEED_VOCAB = [
  ['bonjour','Hallo / Guten Tag','bon.ʒuʁ','Bonjour, comment allez-vous ?'],
  ['merci','Danke','mɛɾsi','Merci beaucoup.'],
  ['s’il vous plaît','bitte','sil vu plɛ','Un café, s’il vous plaît.'],
  ['oui','ja','wi','Oui, bien sûr.'],
  ['non','nein','nɔ̃','Non, merci.'],
  ['bonsoir','Guten Abend','bɔ̃swaʁ','Bonsoir, comment ça va ?'],
  ['au revoir','Auf Wiedersehen','o ʁəvwaʁ','Au revoir, à bientôt.'],
  ['je ne comprends pas','ich verstehe nicht','ʒə nə̃ kɔ̃pʁɑ̃d pa','Désolé, je ne comprends pas.'],
  ['vous parlez anglais ?','Sprechen Sie Englisch ?','vu paʁleɛ̃glɛ','Pardon, vous parlez anglais ?'],
  ['où est la gare ?','Wo ist der Bahnhof ?','u ɛ la ɡaʁ','Excusez-moi, où est la gare ?']
];

const NOTE_TYPES = ['Phonetik','Vokabeln','Grammatik','Lesen','Hören','Übung','Sonstiges'];

/* ================== HILFSFUNKTIONEN ================== */
function esc(s){ return String(s).replace(/[&<>"]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c])); }
function fr(s){ return String(s).split(' ').filter(Boolean).map(w => ({text:w}).text).join(' '); }
function speak(text){
  if(!('speechSynthesis' in window)) return;
  speechSynthesis.cancel();
  const u = new SpeechSynthesisUtterance(text);
  u.lang = 'fr-FR'; u.rate = .85;
  speechSynthesis.speak(u);
}
const fmtH = h => (Math.round(h*10)/10).toLocaleString('de-DE',{minimumFractionDigits:1,maximumFractionDigits:1}) + ' h';
const fmtD = d => d.toLocaleString('de-DE') + ' Tage';

let toastEl, toastTimer;
function toast(msg){
  toastEl.textContent = msg;
  toastEl.classList.add('show');
  clearTimeout(toastTimer);
  toastTimer = setTimeout(()=>toastEl.classList.remove('show'), 2600);
}

/* ================== VOKABELN ================== */
function vocabList(){ return [...state.vocabulary, ...state.extra]; }
function allCats(){
  const cats = new Set();
  vocabList().forEach(v => v.cat && cats.add(v.cat));
  state.extra.forEach(v => v.cat && cats.add(v.cat));
  ['Allgemein','Gruß','Essen','Reisen','Arbeit','Familie'].forEach(c=>cats.add(c));
  return [...cats].sort((a,b)=>a.localeCompare(b,'de'));
}

let deck = [], deckIdx = 0;
function buildDeck(){
  const f = document.getElementById('deck-filter').value;
  const q = document.getElementById('deck-search').value.trim().toLowerCase();
  const onlyLearn = document.getElementById('deck-learn').checked;
  deck = vocabList().filter(v =>
    (f==='alle' || v.cat===f) &&
    (onlyLearn ? v.cat==='Lernende' || state.extra.some(e=>e.fr===v.fr) : true) &&
    (!q || v.fr.toLowerCase().includes(q) || v.de.toLowerCase().includes(q))
  );
  deckIdx = 0;
}
function renderDeck(){
  buildDeck();
  const el = document.getElementById('deck-count');
  el.textContent = deck.length ? `${deck.length} Wörter` : 'Keine Wörter gefunden';
  renderCard();
  renderVocabList();
}
function renderCard(){
  const fc = document.getElementById('flashcard');
  fc.classList.remove('is-flipped');
  document.getElementById('fc-idx').textContent = deck.length ? `${deckIdx+1} / ${deck.length}` : '0 / 0';
  if(!deck.length){
    document.getElementById('fc-front').textContent = '—';
    document.getElementById('fc-back').textContent = 'Kein Wort';
    document.getElementById('fc-cat').textContent = '';
    document.getElementById('fc-pron').textContent = '';
    document.getElementById('fc-ex').textContent = 'Füge unten ein Wort hinzu, um zu starten.';
    return;
  }
  const v = deck[deckIdx];
  document.getElementById('fc-front').textContent = v.fr;
  document.getElementById('fc-back').textContent = v.de;
  document.getElementById('fc-cat').textContent = v.cat || '—';
  document.getElementById('fc-pron').textContent = v.pron ? '/ '+v.pron+' /' : '';
  document.getElementById('fc-ex').textContent = v.ex ? '« '+v.ex+' »' : '';
}
function flip(){ document.getElementById('flashcard').classList.toggle('is-flipped'); }
function go(dir){
  if(!deck.length) return;
  deckIdx = (deckIdx + dir + deck.length) % deck.length;
  flip(); // flip zurück, dann neu
  setTimeout(renderCard, 60);
}
function shuffleDeck(){
  for(let i=deck.length-1;i>0;i--){ const j=Math.floor(Math.random()*(i+1)); [deck[i],deck[j]]=[deck[j],deck[i]]; }
  deckIdx = 0;
  renderCard();
  toast('Deck gemischt');
}
function renderVocabList(){
  const el = document.getElementById('vocab-list');
  if(!deck.length){ el.innerHTML = '<p style="padding:1.5rem 0;color:var(--ink-2)">Keine Wörter in dieser Ansicht.</p>'; return; }
  el.innerHTML = deck.map((v,i)=>{
    const learned = state.extra.some(e=>e.fr===v.fr);
    const del = learned ? '<button data-del="'+esc(v.fr)+'">Entfernen</button>' : '<button data-learn="'+esc(v.fr)+'">Gelernt</button>';
    return '<div class="row"><span class="idx">'+String(i+1).padStart(3,'0')+'</span><span><strong>'+esc(v.fr)+'</strong> — '+esc(v.de)+'</span><span class="cat">'+esc(v.cat||'')+'</span>'+del+'</div>';
  }).join('');
  el.querySelectorAll('[data-learn]').forEach(b=>b.onclick=()=>{
    state.extra.push({fr:b.dataset.learn, de:'', pron:'', ex:'', cat:'Lernende'});
    save(); renderDeck(); toast('Als „Gelernt" markiert');
  });
  el.querySelectorAll('[data-del]').forEach(b=>b.onclick=()=>{
    state.extra = state.extra.filter(e=>e.fr!==b.dataset.del);
    save(); renderDeck(); toast('Markierung entfernt');
  });
}

/* ================== PHONETIK ================== */
function renderPhon(){
  const el = document.getElementById('phon-list');
  el.innerHTML = PHONETIC.map((p,i)=>
    '<button data-i="'+i+'" class="'+(i===0?'is-active':'')+'"><span>'+p.name+'</span><span class="arrow">→</span></button>'
  ).join('');
  el.querySelectorAll('button').forEach(b=>b.onclick=()=>{
    el.querySelectorAll('button').forEach(x=>x.classList.remove('is-active'));
    b.classList.add('is-active');
    renderPhonDetail(+b.dataset.i);
  });
  renderPhonDetail(0);
  const done = Object.values(state.phon).filter(Boolean).length;
  document.getElementById('phon-progress').textContent = done+' / '+PHONETIC.length+' Einheiten';
}
function renderPhonDetail(i){
  const p = PHONETIC[i];
  const box = document.getElementById('phon-detail');
  box.innerHTML =
    '<h3>'+p.name+'</h3>'+
    '<p class="hint">'+p.hint+'</p>'+
    '<div class="exs">'+p.ex.map(w=>'<button data-w="'+esc(w)+'">'+esc(w)+'</button>').join('')+'</div>'+
    '<div class="flex" style="display:flex;justify-content:space-between;align-items:center;border-top:1px solid var(--line);margin-top:.6rem;padding-top:1rem">'+
      '<span class="mono" style="font-size:10px;letter-spacing:.16em;text-transform:uppercase;color:var(--ink-2)">Tippe auf ein Wort zum Aussprechen</span>'+
      '<button class="btn btn--sm '+(state.phon[p.id]?'btn--solid':'')+'" id="phon-done">'+(state.phon[p.id]?'✓ Erledigt':'Erledigt markieren')+'</button>'+
    '</div>';
  box.querySelectorAll('.exs button').forEach(b=>b.onclick=()=>speak(b.dataset.w));
  document.getElementById('phon-done').onclick=()=>{
    state.phon[p.id] = !state.phon[p.id];
    save();
    renderPhon();
    toast(state.phon[p.id] ? 'Einheit abgeschlossen' : 'Markierung entfernt');
  };
}

/* ================== GRAMMATIK ================== */
function renderGram(){
  const el = document.getElementById('gram-list');
  el.innerHTML = GRAMMAR.map((g,i)=>
    '<button data-i="'+i+'" class="'+(i===0?'is-active':'')+'"><span>'+g.name+'</span><span class="arrow">→</span></button>'
  ).join('');
  el.querySelectorAll('button').forEach(b=>b.onclick=()=>{
    el.querySelectorAll('button').forEach(x=>x.classList.remove('is-active'));
    b.classList.add('is-active');
    renderGramDetail(+b.dataset.i);
  });
  renderGramDetail(0);
  const done = Object.values(state.gram).filter(Boolean).length;
  document.getElementById('gram-progress').textContent = done+' / '+GRAMMAR.length+' Themen';
}
function renderGramDetail(i){
  const g = GRAMMAR[i];
  const box = document.getElementById('gram-detail');
  box.innerHTML =
    '<h3 style="font-size:1.6rem;font-weight:500">'+g.name+'</h3>'+
    '<p>'+g.hint+'</p>'+
    '<h4>Beispielsätze</h4>'+
    '<div class="examples">'+g.ex.map(s=>'<div><span>'+esc(s)+'</span><button data-w="'+esc(s)+'" title="Aussprechen">◊</button></div>').join('')+'</div>'+
    '<div style="display:flex;justify-content:flex-end;margin-top:.4rem">'+
      '<button class="btn btn--sm '+(state.gram[g.id]?'btn--solid':'')+'" id="gram-done">'+(state.gram[g.id]?'✓ Erledigt':'Erledigt markieren')+'</button>'+
    '</div>';
  box.querySelectorAll('.examples button').forEach(b=>b.onclick=()=>speak(b.dataset.w));
  document.getElementById('gram-done').onclick=()=>{
    state.gram[g.id] = !state.gram[g.id];
    save();
    renderGram();
    toast(state.gram[g.id] ? 'Thema abgeschlossen' : 'Markierung entfernt');
  };
}

/* ================== MATERIAL ================== */
function renderMaterial(){
  const row = m => '<div class="mat-item"><a href="'+m.url+'" target="_blank" rel="noopener"><span>'+esc(m.name)+'</span><span class="chip">'+m.tag+'</span></a></div>';
  document.getElementById('mat-reading').innerHTML = '<h4 style="font-family:IBM Plex Mono;font-size:10px;letter-spacing:.2em;text-transform:uppercase;color:var(--ink-2);margin-bottom:.6rem">Lesen</h4>' + READING.map(row).join('');
  document.getElementById('mat-practice').innerHTML = '<h4 style="font-family:IBM Plex Mono;font-size:10px;letter-spacing:.2em;text-transform:uppercase;color:var(--ink-2);margin-bottom:.6rem">Hören &amp; Üben</h4>' + PRACTICE.map(row).join('');
}

/* ================== FORTSCHRITT ================== */
function renderLog(){
  const el = document.getElementById('log');
  const noteSel = document.getElementById('log-note');
  noteSel.innerHTML = NOTE_TYPES.map(n=>'<option value="'+n+'">'+n+'</option>').join('');
  const rows = [...state.log].reverse();
  if(!rows.length){ el.innerHTML = '<p class="log--empty">Noch keine Einträge — trage oben deine erste Lerneinheit ein.</p>'; return; }
  el.innerHTML = rows.map(l=>
    '<div class="row"><span>'+l.date+'</span><span class="t">'+l.note+'</span><span class="t">'+l.mins+' Min.</span>'+
    '<span class="act"><button data-del="'+l.id+'">Löschen</button></span></div>'
  ).join('');
  el.querySelectorAll('[data-del]').forEach(b=>b.onclick=()=>{
    state.log = state.log.filter(x=>x.id!==+b.dataset.del);
    save(); renderLog(); updateDash(); toast('Eintrag gelöscht');
  });
}
function addLog(){
  const date = document.getElementById('log-date').value || today();
  const mins = parseInt(document.getElementById('log-mins').value,10) || 0;
  const note = document.getElementById('log-note').value;
  if(!mins){ toast('Bitte Minuten eingeben'); return; }
  state.log.push({id:Date.now(), date, mins, note});
  save();
  document.getElementById('log-mins').value = '';
  renderLog(); updateDash();
  toast(mins+' Min. protokolliert');
}
function exportLog(){
  if(!state.log.length){ toast('Nichts zum Exportieren'); return; }
  let csv = 'Datum;Notiz;Minuten\n';
  state.log.forEach(l=>csv += l.date+';'+l.note+';'+l.mins+'\n');
  const blob = new Blob(['\ufeff'+csv], {type:'text/csv;charset=utf-8'});
  const a = document.createElement('a');
  a.href = URL.createObjectURL(blob);
  a.download = 'methode-fortschritt.csv';
  a.click();
  toast('CSV exportiert');
}

/* ================== DASHBOARD ================== */
function hoursLogged(){ return state.log.reduce((s,l)=>s+l.mins,0)/60; }
function vocabDone(){
  const n = Math.min(vocabList().filter(v=>state.extra.some(e=>e.fr===v.fr)).length, TOTAL_VOCAB);
  return n;
}
function updateDash(){
  const now = new Date();
  const days = Math.max(0, Math.ceil((GOAL-now)/86400000));
  document.getElementById('hud-days').textContent = days.toLocaleString('de-DE');
  document.getElementById('hud-daily').textContent = DAILY;
  document.getElementById('hud-start').textContent = new Date(state.start).toLocaleDateString('de-DE');

  const vP = vocabDone()/TOTAL_VOCAB;
  const hP = Math.min(hoursLogged()/TOTAL_HOURS, 1);
  const overall = Math.min((vP+hP)/2, 1);
  document.getElementById('dash-pct').textContent = Math.round(overall*100)+'%';
  document.getElementById('dash-fill').style.width = (overall*100)+'%';
  document.getElementById('dash-studied').textContent = vocabDone();
  document.getElementById('dash-vocab-total').textContent = TOTAL_VOCAB;
  document.getElementById('dash-hours').textContent = fmtH(hoursLogged());

  const todayMin = state.log.filter(l=>l.date===today()).reduce((s,l)=>s+l.mins,0);
  const tP = Math.min(todayMin/DAILY,1);
  document.getElementById('day-fill').style.width = (tP*100)+'%';
  document.getElementById('day-mins').textContent = todayMin+' / '+DAILY+' Min.';

  const studiedPct = Math.round(vocabDone()/TOTAL_VOCAB*100);
  document.getElementById('vocab-progress').textContent = vocabDone()+' / '+TOTAL_VOCAB+' Wörter';
}

/* ================== INIT ================== */
function init(){
  toastEl = document.getElementById('toast');
  // Seed-Vokabeln einmalig
  if(!state.vocabulary.length && !sessionStorage.getItem('seeded')){
    const cats = ['Gruß','Gruß','Allgemein','Gruß','Allgemein','Gruß','Allgemein','Gruß','Gruß','Reisen'];
    SEED_VOCAB.forEach((v,i)=>state.vocabulary.push({fr:v[0],de:v[1],pron:v[2],ex:v[3],cat:cats[i]}));
    save(); sessionStorage.setItem('seeded','1');
  }
  // Dropdowns befüllen
  const cats = allCats();
  document.getElementById('deck-filter').innerHTML = '<option value="alle">Alle Kategorien</option>' + cats.map(c=>'<option>'+c+'</option>').join('');
  const catSel = document.getElementById('v-cat');
  catSel.innerHTML = ['Allgemein','Gruß','Essen','Reisen','Arbeit','Familie','Sonstiges'].map(c=>'<option>'+c+'</option>').join('');
  document.getElementById('log-date').value = today();

  renderDeck();
  renderPhon();
  renderGram();
  renderMaterial();
  renderLog();
  updateDash();

  // Events
  document.getElementById('fc-inner').addEventListener('click', e=>{ if(!e.target.closest('button')) flip(); });
  document.getElementById('fc-flip').onclick = flip;
  document.getElementById('fc-next').onclick = ()=>go(1);
  document.getElementById('fc-prev').onclick = ()=>go(-1);
  document.getElementById('fc-shuffle').onclick = shuffleDeck;
  document.getElementById('fc-say1').onclick = ()=>{ const v=deck[deckIdx]; if(v) speak(v.fr); };
  document.getElementById('fc-say2').onclick = ()=>{ const v=deck[deckIdx]; if(v) speak(v.fr); };
  document.getElementById('deck-filter').onchange = renderDeck;
  document.getElementById('deck-search').oninput = renderDeck;
  document.getElementById('deck-learn').onchange = renderDeck;

  document.getElementById('v-add').onclick = ()=>{
    const f = document.getElementById('v-fr').value.trim();
    const d = document.getElementById('v-de').value.trim();
    const p = document.getElementById('v-pron').value.trim();
    const e = document.getElementById('v-ex').value.trim();
    const c = document.getElementById('v-cat').value;
    if(!f || !d){ toast('Französisch und Deutsch angeben'); return; }
    if(vocabList().some(v=>v.fr.toLowerCase()===f.toLowerCase())){ toast('Wort existiert bereits'); return; }
    state.extra.push({fr:f,de:d,pron:p,ex:e,cat:c});
    save();
    ['v-fr','v-de','v-pron','v-ex'].forEach(id=>document.getElementById(id).value='');
    renderDeck(); updateDash();
    toast('„'+f+'\" hinzugefügt');
  };

  document.getElementById('log-add').onclick = addLog;
  document.getElementById('log-export').onclick = exportLog;

  // Menü & Header
  const header = document.getElementById('site-header');
  addEventListener('scroll', ()=>header.classList.toggle('is-scrolled', scrollY>4), {passive:true});
  const mmenu = document.getElementById('mmenu');
  document.getElementById('nav-toggle').onclick = ()=>{ mmenu.classList.add('is-open'); mmenu.setAttribute('aria-hidden','false'); document.body.style.overflow='hidden'; };
  const closeM = ()=>{ mmenu.classList.remove('is-open'); mmenu.setAttribute('aria-hidden','true'); document.body.style.overflow=''; };
  document.getElementById('mmenu-close').onclick = closeM;
  mmenu.querySelectorAll('nav a').forEach(a=>a.onclick=closeM);

  // Reveal
  const io = new IntersectionObserver(es=>es.forEach(e=>{ if(e.isIntersecting){ e.target.classList.add('is-in'); io.unobserve(e.target); }}),{threshold:.12});
  document.querySelectorAll('.reveal').forEach(el=>io.observe(el));

  // Scrollspy
  const links = document.querySelectorAll('.main-nav a');
  const spy = new IntersectionObserver(es=>{
    es.forEach(e=>{ if(e.isIntersecting){ links.forEach(l=>l.classList.toggle('is-active', l.getAttribute('href')==='#'+e.target.id)); } });
  },{rootMargin:'-40% 0px -55% 0px'});
  ['phonetik','vokabeln','grammatik','material','fortschritt'].forEach(id=>{ const el=document.getElementById(id); if(el) spy.observe(el); });
}
init();
</script>
</body>
</html>
